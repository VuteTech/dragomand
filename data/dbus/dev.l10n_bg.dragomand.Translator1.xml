<!--
  The public contract of dragomand, API major version 1.

  Bus name:    dev.l10n_bg.dragomand.Translator1 (session bus)
  Object path: /dev/l10n_bg/dragomand/Translator1

  Slow methods return a request object path immediately; results, progress
  and errors arrive as signals on that object (the xdg-desktop-portal
  Request pattern). Clients pass options["handle_token"] (string) so they
  can compute the request path -
  /dev/l10n_bg/dragomand/request/<escaped sender>/<token>, with every
  non-alphanumeric character of the sender's unique name replaced by "_" -
  and subscribe to Response before the method call returns.

  Response codes: 0 success, 1 cancelled, 2 error. Result dictionaries:
  Translate: "translations" (as), "pivot" (s, only when pivoting),
  "sentences" (aa(uuuu), only when asked for); errors put "error" (s).

  Additions within API version 1 (new methods, options and keys; nothing
  existing changed): TranslateFd, DetectLanguage, GetConfig, SetConfig
  and ConfigChanged; the Translate option "sentences"; the pair keys
  "release_status" and "quality". A client can tell whether the daemon
  has them from its introspection.

  Errors: dev.l10n_bg.dragomand.Error.{InvalidArgument, UnsupportedPair,
  NotInstalled, LimitExceeded, NetworkDisabled, EngineFailure}.

  A test compares this file with the daemon's live introspection, so it
  cannot drift by accident.
-->
<node>
  <interface name="dev.l10n_bg.dragomand.Translator1">
    <!--
      Lists installed pairs and (from the cached records, never the
      network) available pairs. Per pair: "source" (s), "target" (s),
      "installed_version" (s), "available_version" (s), "origin"
      (s: system|user), "size" (t, installed bytes), "architecture" (s).
      From the model registry, when CheckForUpdates has cached it, and
      describing the installed model (or, for a pair not installed, the one
      an install would fetch): "release_status" (s, Mozilla's label such
      as "Release" or "Nightly") and "quality" (d, COMET-22 on the
      flores200-plus test set, 0 to 1, higher is better). Missing keys
      mean unknown.
    -->
    <method name="ListLanguagePairs">
      <arg type="aa{sv}" direction="out"/>
    </method>
    <!--
      Install if missing (network), then load. Options: "handle_token" (s),
      "allow_pivot" (b, default true). Results: "version" (s), "pivot" (s).
    -->
    <method name="PreparePair">
      <arg name="source" type="s" direction="in"/>
      <arg name="target" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg type="o" direction="out"/>
    </method>
    <!--
      Translate short text segments; documents go through TranslateFd.
      Options: "handle_token" (s), "html" (b), "allow_pivot" (b, default
      true), "priority" (s: interactive|batch), "sentences" (b): also
      return "sentences", per segment the (source begin, source end,
      translation begin, translation end) of every sentence, in Unicode
      code points; sentence i of a translation renders sentence i of its
      source.
    -->
    <method name="Translate">
      <arg name="source" type="s" direction="in"/>
      <arg name="target" type="s" direction="in"/>
      <arg name="segments" type="as" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg type="o" direction="out"/>
    </method>
    <!--
      Translates a document: UTF-8 text read from "input" until end of file
      (at most 64 MiB), translated line by line (lines without a letter or
      digit are copied), written to "output". Pipes and files (memfd)
      both work; with a file, the output is written from the current
      offset. Options: "handle_token" (s), "html" (b), "allow_pivot" (b,
      default true), "priority" (s, default batch). Progress reports the
      fraction of lines done. Results: "lines" (u, lines translated),
      "pivot" (s, only when pivoting).
    -->
    <method name="TranslateFd">
      <arg name="source" type="s" direction="in"/>
      <arg name="target" type="s" direction="in"/>
      <arg name="input" type="h" direction="in"/>
      <arg name="output" type="h" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg type="o" direction="out"/>
    </method>
    <!--
      Identifies the language of a text (the first 64 KiB), offline and
      fast. Options: "candidates" (as) restricts the answer to these
      languages. Results: "language" (s, absent when nothing was
      detected), "confidence" (d, 0 to 1), "reliable" (b).
    -->
    <method name="DetectLanguage">
      <arg name="text" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg type="a{sv}" direction="out"/>
    </method>
    <!--
      Install or upgrade one pair from the provider (network).
      Options: "handle_token" (s). Results: "version" (s),
      "architecture" (s).
    -->
    <method name="InstallPair">
      <arg name="source" type="s" direction="in"/>
      <arg name="target" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg type="o" direction="out"/>
    </method>
    <!-- Removes every user-store copy of the pair. System copies stay. -->
    <method name="RemovePair">
      <arg name="source" type="s" direction="in"/>
      <arg name="target" type="s" direction="in"/>
    </method>
    <!--
      Refreshes the record cache and the model registry (network) and
      reports available updates.
      Options: "handle_token" (s). Results: "updates" (as, one
      "src-trg installed -> available" line per update).
    -->
    <method name="CheckForUpdates">
      <arg name="options" type="a{sv}" direction="in"/>
      <arg type="o" direction="out"/>
    </method>
    <!-- "version" (s), "loaded" (as, loaded routes), "queued" (u). -->
    <method name="GetStatus">
      <arg type="a{sv}" direction="out"/>
    </method>
    <!--
      The configuration: "memory_budget_mb" (t), "keep_warm" (u),
      "keep_warm_seconds" (t), "idle_exit_seconds" (t), "network" (b),
      "allow_prerelease" (b).
    -->
    <method name="GetConfig">
      <arg type="a{sv}" direction="out"/>
    </method>
    <!--
      Changes some of GetConfig's keys (integers of any width are
      accepted), writes them to config.toml and applies them at once. All
      or nothing: an unknown key or a bad value (InvalidArgument) changes
      nothing.
    -->
    <method name="SetConfig">
      <arg name="changes" type="a{sv}" direction="in"/>
    </method>
    <!-- The whole configuration, after every SetConfig. -->
    <signal name="ConfigChanged">
      <arg name="config" type="a{sv}"/>
    </signal>
    <property name="Version" type="s" access="read"/>
  </interface>
  <!--
    Served at /dev/l10n_bg/dragomand/request/<escaped sender>/<token>
    while a request is in flight. Response is emitted exactly once; the
    object disappears afterwards.
  -->
  <interface name="dev.l10n_bg.dragomand.Request1">
    <method name="Cancel"/>
    <signal name="Progress">
      <arg name="fraction" type="d"/>
      <arg name="stage" type="s"/>
    </signal>
    <signal name="Response">
      <arg name="code" type="u"/>
      <arg name="results" type="a{sv}"/>
    </signal>
  </interface>
</node>
