# Maintainer: Blagovest Petrov <blagovest@petrovs.info>
#
# Builds from a local release tarball:
#   scripts/make-release-tarball.sh packaging/obs/
#   cd packaging/obs && makepkg
# The release workflow also publishes this file to OBS (with pkgver
# stamped from the tag) next to the vendored tarball, whose
# .cargo/config.toml keeps cargo offline.

pkgname=dragomand
pkgver=0.1.0
pkgrel=1
pkgdesc="Offline machine translation daemon for the desktop (D-Bus, Mozilla Bergamot models)"
arch=(x86_64 aarch64)
url="https://dragomand.l10n-bg.dev"
license=(GPL-3.0-or-later)
# makepkg's -flto=auto produces GCC-IR static libraries (bundled zstd, the
# engine) that rustc's lld linker cannot read; Rust's own thin LTO still
# applies via the workspace profile.
options=(!lto)
depends=(cblas lapack pcre2 dbus gcc-libs)
optdepends=('openblas: faster float paths (or install blas-openblas as the BLAS provider)')
makedepends=(rust cmake ninja pkgconf)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"

  # Engine first: library-only native build, generic CBLAS, no MKL.
  # Distribution baselines; the x86-64 int8 path dispatches by CPUID.
  local build_arch=x86-64-v2
  [[ $CARCH == aarch64 ]] && build_arch=armv8-a
  cmake -S engine -B engine/build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_ARCH=$build_arch
  cmake --build engine/build -- $NINJAFLAGS

  export DRAGOMAN_ENGINE_LIB_DIR="$PWD/engine/build"
  cargo build --release --locked --workspace

  ./target/release/dragomanctl manpage > dragomanctl.1
  ./target/release/dragomanctl completions bash > dragomanctl.bash
  ./target/release/dragomanctl completions zsh > _dragomanctl
  ./target/release/dragomanctl completions fish > dragomanctl.fish
}

check() {
  cd "$pkgname-$pkgver"
  export DRAGOMAN_ENGINE_LIB_DIR="$PWD/engine/build"
  cargo test --release --locked --workspace
}

package() {
  cd "$pkgname-$pkgver"

  # The daemon and the KRunner service are D-Bus activated, not in PATH.
  install -Dm755 target/release/dragomand "$pkgdir/usr/lib/dragomand/dragomand"
  install -Dm755 target/release/dragoman-krunner \
    "$pkgdir/usr/lib/dragomand/dragoman-krunner"
  install -Dm755 target/release/dragoman-search-provider \
    "$pkgdir/usr/lib/dragomand/dragoman-search-provider"
  install -Dm755 target/release/dragomanctl "$pkgdir/usr/bin/dragomanctl"

  install -Dm644 data/systemd/dragomand.service \
    "$pkgdir/usr/lib/systemd/user/dragomand.service"
  install -Dm644 data/systemd/dragomand-update.service \
    "$pkgdir/usr/lib/systemd/user/dragomand-update.service"
  install -Dm644 data/systemd/dragomand-update.timer \
    "$pkgdir/usr/lib/systemd/user/dragomand-update.timer"
  install -Dm644 data/dbus/dev.l10n_bg.dragomand.Translator1.service \
    "$pkgdir/usr/share/dbus-1/services/dev.l10n_bg.dragomand.Translator1.service"
  install -Dm644 data/dbus/dev.l10n_bg.dragomand.KRunner1.service \
    "$pkgdir/usr/share/dbus-1/services/dev.l10n_bg.dragomand.KRunner1.service"
  install -Dm644 data/dbus/dev.l10n_bg.dragomand.Translator1.xml \
    "$pkgdir/usr/share/dbus-1/interfaces/dev.l10n_bg.dragomand.Translator1.xml"
  install -Dm644 data/krunner/dragoman-runner.desktop \
    "$pkgdir/usr/share/krunner/dbusplugins/dragoman-runner.desktop"
  install -Dm644 data/dbus/dev.l10n_bg.dragomand.SearchProvider.service \
    "$pkgdir/usr/share/dbus-1/services/dev.l10n_bg.dragomand.SearchProvider.service"
  install -Dm644 data/gnome/dev.l10n_bg.dragomand.search-provider.ini \
    "$pkgdir/usr/share/gnome-shell/search-providers/dev.l10n_bg.dragomand.search-provider.ini"
  install -Dm644 data/gnome/dev.l10n_bg.dragomand.desktop \
    "$pkgdir/usr/share/applications/dev.l10n_bg.dragomand.desktop"
  install -Dm644 artwork/dragomand-icon.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.l10n_bg.dragomand.svg"

  install -d "$pkgdir/usr/share/doc/$pkgname/integrations"
  install -m644 integrations/README.md integrations/*.sh \
    "$pkgdir/usr/share/doc/$pkgname/integrations/"

  install -Dm644 data/config.toml.example \
    "$pkgdir/usr/share/doc/$pkgname/config.toml.example"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  install -Dm644 dragomanctl.1 "$pkgdir/usr/share/man/man1/dragomanctl.1"
  install -Dm644 dragomanctl.bash \
    "$pkgdir/usr/share/bash-completion/completions/dragomanctl"
  install -Dm644 _dragomanctl "$pkgdir/usr/share/zsh/site-functions/_dragomanctl"
  install -Dm644 dragomanctl.fish \
    "$pkgdir/usr/share/fish/vendor_completions.d/dragomanctl.fish"

  # Third-party license texts for the vendored engine (GPL text itself is
  # covered by the license= array).
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  install -m644 engine/vendor/LICENSES/* "$pkgdir/usr/share/licenses/$pkgname/"
}
